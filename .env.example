# ---- Groq (OpenAI-compatible API) --------------------------------
# Leave empty for offline demo mode. XAI_API_KEY and LLM_API_KEY
# are also accepted as legacy key names.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Keep email context within the free-tier token budget.
DEFAULT_EMAILS=5
EMAIL_BODY_CHARS=400

# ---- Real email (Gmail example) ---------------------------------
# Use an APP PASSWORD, not your normal password:
# Google Account > Security > 2-Step Verification > App passwords
# Leave EMAIL_ADDRESS empty to use the sample inbox in data/emails.json
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Safety: the agent may only send mail by itself if this is true AND your
# request contains the word "send". Otherwise replies are saved as drafts
# that you approve with a button in the UI.
ALLOW_AGENT_SEND=false
